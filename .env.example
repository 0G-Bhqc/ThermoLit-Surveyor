# ThermoLit-Surveyor Literature Survey Agent - Environment Configuration
# 复制本文件为 .env 后填写真实值(config.py 会通过 python-dotenv 自动加载 .env)

# Sciverse API Token (Register and obtain token from https://sciverse.opendatalab.com)
SCIVERSE_TOKEN=your_sciverse_token_here

# DeepSeek LLM API Credentials (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# --- 可选调优项 ---
# LLM 采样温度(抽取/查询生成建议 0)
# LLM_TEMPERATURE=0.0
# 每轮检索返回段落数
# SEARCH_TOP_K=3
# Pass 2 生成的定向查询数
# NUM_FOLLOWUP_QUERIES=2
# 送入 LLM 的摘要最大字符数
# MAX_EXCERPT_CHARS=3500
# LLM 并行抽取线程数
# LLM_MAX_CONCURRENCY=4
# 结果缓存(sqlite 路径;同 prompt/query 的重复调研零 API 消耗)
# THERMOLIT_CACHE=eval/cache/runs.db
# 日志级别 DEBUG/INFO/WARNING
# LOG_LEVEL=INFO
